{
  "schemaVersion": 1,
  "id": "router/route-state",
  "package": "@beforesemicolon/router",
  "version": "1.5.0",
  "name": "getPageParams / getSearchParams / getPageData",
  "summary": "Read active route parameters, query state, or navigation payload.",
  "setup": {
    "npm": {
      "specifier": "@beforesemicolon/router",
      "names": [
        "getPageParams",
        "getSearchParams",
        "getPageData",
        "updateSearchQuery",
        "parsePathname"
      ],
      "import": "import { getPageParams, getSearchParams, getPageData, updateSearchQuery, parsePathname } from '@beforesemicolon/router'",
      "registration": "The npm root registers its custom elements automatically."
    },
    "classic": {
      "scripts": [
        {
          "package": "@beforesemicolon/web-component",
          "version": "1.22.0",
          "path": "dist/client.js",
          "global": "BFS.WebComponent"
        },
        {
          "package": "@beforesemicolon/router",
          "version": "1.5.0",
          "path": "dist/client.js",
          "global": "BFS.ROUTER"
        }
      ],
      "globals": [
        "BFS.ROUTER.getPageParams",
        "BFS.ROUTER.getSearchParams",
        "BFS.ROUTER.getPageData",
        "BFS.ROUTER.updateSearchQuery",
        "BFS.ROUTER.parsePathname"
      ],
      "requiredGlobals": [
        "BFS.WebComponent",
        "BFS.MARKUP"
      ],
      "registration": "The script registers its custom elements automatically."
    }
  },
  "api": {
    "signatures": {
      "getPageParams": "<T extends Record<string, string>>() => T",
      "getSearchParams": "<T extends Record<string, string>>() => T",
      "getPageData": "<T extends Record<string, unknown>>() => T",
      "updateSearchQuery": "(query: Record<string, unknown> | null) => void",
      "parsePathname": "(pathnamePattern: string) => string"
    }
  },
  "example": {
    "npm": "import { getPageParams, getSearchParams, getPageData, updateSearchQuery, parsePathname } from '@beforesemicolon/router'\n\nupdateSearchQuery({ tab: 'profile' })\nconsole.log(getPageParams(), getPageData())",
    "classic": "BFS.ROUTER.updateSearchQuery({ tab: 'profile' })"
  },
  "links": [
    {
      "label": "Documentation",
      "url": "https://router.beforesemicolon.com/documentation/routing-apis/params-queries.html"
    },
    {
      "label": "router/page-data",
      "url": "page-data.json"
    },
    {
      "label": "router/page-route-query",
      "url": "page-route-query.json"
    },
    {
      "label": "router/subscriptions",
      "url": "subscriptions.json"
    }
  ],
  "guidance": [
    "getSearchParams reads location.search. In hash mode, use onPage location.query where verified or parse getHashSearch in npm mode; do not read the HTML document search as route state."
  ]
}
