{
  "schemaVersion": 1,
  "id": "router/route-modules",
  "package": "@beforesemicolon/router",
  "version": "1.5.0",
  "name": "registerRouteModules / preloadRouteModule",
  "summary": "Register lazy route modules for bundlers, resolve, or preload them.",
  "setup": {
    "npm": {
      "specifier": "@beforesemicolon/router",
      "names": [
        "registerRouteModules",
        "getRouteModule",
        "resolveRouteModule",
        "preloadRouteModule",
        "preloadRouteModules"
      ],
      "import": "import { registerRouteModules, getRouteModule, resolveRouteModule, preloadRouteModule, preloadRouteModules } from '@beforesemicolon/router'",
      "registration": "The npm root registers its custom elements automatically."
    },
    "classic": {
      "scripts": [
        {
          "package": "@beforesemicolon/web-component",
          "version": "1.22.0",
          "path": "dist/client.js",
          "global": "BFS.WebComponent"
        },
        {
          "package": "@beforesemicolon/router",
          "version": "1.5.0",
          "path": "dist/client.js",
          "global": "BFS.ROUTER"
        }
      ],
      "globals": [
        "BFS.ROUTER.registerRouteModules",
        "BFS.ROUTER.getRouteModule",
        "BFS.ROUTER.resolveRouteModule",
        "BFS.ROUTER.preloadRouteModule",
        "BFS.ROUTER.preloadRouteModules"
      ],
      "requiredGlobals": [
        "BFS.WebComponent",
        "BFS.MARKUP"
      ],
      "registration": "The script registers its custom elements automatically."
    }
  },
  "api": {
    "signatures": {
      "registerRouteModules": "(modules: Record<string, () => Promise<unknown>>) => void",
      "getRouteModule": "(path: string) => (() => Promise<unknown>) | undefined",
      "resolveRouteModule": "(path: string) => Promise<unknown | undefined>",
      "preloadRouteModule": "(path: string) => Promise<void>",
      "preloadRouteModules": "(paths: string[]) => Promise<void>"
    }
  },
  "example": {
    "npm": "import { registerRouteModules, getRouteModule, resolveRouteModule, preloadRouteModule, preloadRouteModules } from '@beforesemicolon/router'\n\nregisterRouteModules({ './about.js': () => Promise.resolve({ default: '<h1>About</h1>' }) })\nawait preloadRouteModule('./about.js')",
    "classic": "BFS.ROUTER.registerRouteModules({ './about.js': () => Promise.resolve({ default: '<h1>About</h1>' }) })"
  },
  "links": [
    {
      "label": "Documentation",
      "url": "https://router.beforesemicolon.com/documentation/advanced-features/module-registry.html"
    }
  ]
}
