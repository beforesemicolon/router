{
    "name": "@beforesemicolon/router",
    "version": "1.4.0",
    "description": "Web component router by Before Semicolon",
    "engines": {
        "node": ">=22.13.0",
        "npm": ">=10.0.0"
    },
    "type": "module",
    "types": "./dist/types/index.d.ts",
    "exports": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js",
        "default": "./dist/cjs/index.js"
    },
    "scripts": {
        "lint": "eslint ./src && prettier --check ./src",
        "format": "eslint ./src --fix && prettier --write ./src",
        "test": "jest --coverage",
        "test:watch": "jest --watch",
        "local": "run-p local:watch local:serve",
        "local:watch": "node build-docs.js && nodemon --exec 'node build-docs.js'",
        "local:serve": "npx netlify dev --offline --no-open --skip-gitignore --dir website --port 8080 --staticServerPort 3998",
        "local:serve:pt": "npx http-server ./website/pt -p 8083",
        "build": "npm-run-all build:package build:docs",
        "build:package": "rm -rf dist && npm-run-all lint test && tsc --emitDeclarationOnly && node build.js",
        "build:docs": "node build-docs.js",
        "local:serve:en": "npx http-server ./website/en -p 8080",
        "local:serve:zh": "npx http-server ./website/zh -p 8081",
        "local:serve:es": "npx http-server ./website/es -p 8082",
        "local:serve:fr": "npx http-server ./website/fr -p 8084"
    },
    "keywords": [
        "web-component",
        "javascript",
        "markup",
        "router",
        "web"
    ],
    "author": "Elson Correia",
    "license": "BSD-3-Clause",
    "repository": {
        "url": "https://github.com/beforesemicolon/router",
        "type": "git"
    },
    "devDependencies": {
        "@beforesemicolon/builder": "^2.0.1",
        "@beforesemicolon/site-builder": "^1.12.0",
        "@eslint/js": "^10.0.1",
        "@types/jest": "^29.5.1",
        "@types/jsdom": "^21.1.1",
        "@typescript-eslint/eslint-plugin": "^8.71.0",
        "@typescript-eslint/parser": "^8.71.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-n": "^18.4.0",
        "eslint-plugin-promise": "^7.3.0",
        "http-server": "^14.1.1",
        "http-server-spa": "^1.3.0",
        "jest": "^29.5.0",
        "jest-environment-jsdom": "^30.3.0",
        "jsdom": "^29.0.1",
        "nodemon": "^3.1.7",
        "npm-run-all": "^4.1.5",
        "prettier": "3.9.9",
        "ts-jest": "^29.1.0",
        "typescript": "^5.0.4"
    },
    "dependencies": {
        "@beforesemicolon/web-component": "^1.21.0"
    },
    "overrides": {
        "html-minifier": "npm:@keep-lts/html-minifier@4.0.1",
        "minimatch@9.0.3": "9.0.9"
    }
}
